["Т14: Текст - Уведомление о выбранной роли при входе в рейд"] = {
["outline"] = "OUTLINE",
["wagoID"] = "X2r68vxMW",
["parent"] = "Т14 Тексты: Все боссы",
["preferToUpdate"] = false,
["customText"] = "function()\n    local roleText = aura_env.role\n    local colorCode = \"|cFFFFFFFF\"\n    \n    if aura_env.role == \"DAMAGER\" then\n        roleText = \"ДД\"\n        colorCode = \"|cFF4dff5d\"\n    elseif aura_env.role == \"HEALER\" then\n        roleText = \"Хилл\"\n        colorCode = \"|cFF4dff5d\"\n    elseif aura_env.role == \"TANKER\" or aura_env.role == \"TANK\" then\n        roleText = \"Танк\"\n        colorCode = \"|cFF4dff5d\"\n    end\n    \n    return colorCode .. roleText .. \"|r\"\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.role = UnitGroupRolesAssigned(\"player\")",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "10",
["event"] = "Health",
["unit"] = "player",
["debuffType"] = "HELPFUL",
["spellIds"] = {
},
["custom"] = "function(event,...)\n    local name = GetInstanceInfo()\n    if event == \"OPTIONS\" then\n        aura_env.role = UnitGroupRolesAssigned(\"player\")\n        return true\n    end\n    \n    if name == \"Подземелья Могу'шан\" or name == \"Mogu'shan Vaults\" or name == \"Сердце Страха\" or name == \"Heart of Fear\" or name == \"Терраса Вечной Весны\" or name == \"Terrace of Endless Spring\" then\n        aura_env.role = UnitGroupRolesAssigned(\"player\")\n        print(\"|cFFa2fff9Проверить версию пака игроков в рейде - команда|r |cFF4dff5d!ПАК|r |cFFa2fff9в рейдовый чат|r\")\n        return true\n    end\nend",
