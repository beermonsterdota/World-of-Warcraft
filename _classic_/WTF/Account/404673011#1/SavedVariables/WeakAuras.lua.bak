["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,sourceName,_,_,destGUID,destName,_,_,spellId)\n    \n    if subEvent == \"SPELL_CAST_START\" and spellId == 122402 then\n        allstates[\"\"] = {\n            progressType = \"timed\",\n            duration = aura_env.castTime,\n            expirationTime = GetTime() + aura_env.castTime,\n            autoHide = true,\n            show = true,\n            changed = true,\n            state = \"Casting\",\n            interrupter = \"\",\n        }\n        return true\n    elseif subEvent == \"SPELL_INTERRUPT\" then\n        if allstates[\"\"] then\n            allstates[\"\"].duration = 1.25\n            allstates[\"\"].expirationTime = GetTime() + 1.25\n            allstates[\"\"].changed = true\n            allstates[\"\"].state = \"Kicked\"\n            allstates[\"\"].interrupter = sourceName\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        local  _, _, difficultyID = GetInstanceInfo()\n        if difficultyID == 5 or difficultyID == 6 then\n            aura_env.castTime = 2.5\n        else\n            aura_env.castTime = 4\n        end\n        return true\n    end\nend",
["events"] = "ENCOUNTER_START, CLEU:SPELL_CAST_START, CLEU:SPELL_INTERRUPT",
