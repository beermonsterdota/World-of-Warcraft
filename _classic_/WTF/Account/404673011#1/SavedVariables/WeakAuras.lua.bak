["auto"] = true,
["tocversion"] = 50500,
["id"] = "ТВВ: Иконка Защитники - Прикосновение ша",
["customText"] = "function()\n    local multi = 120000 -- 25 гер\n    local _, _, difficultyID = GetInstanceInfo()\n    -- 3 = 10 Нормал; 4 = 25 Нормал; 5 = 10 Героик; 6 = 25 Героик; 17 = ЛФР\n    if difficultyID == 3 then\n        multi =  38500\n    elseif difficultyID == 4 then\n        multi = 38500\n    elseif difficultyID == 5 then\n        multi = 12000\n    elseif difficultyID == 17 then\n        multi = 13000\n    end\n    local colorCode = \"|cFFfff468\"\n    \n    if multi / 1000 / 3 < 1000 then\n        return colorCode .. math.floor(multi / 1000 / 3) .. \"k/с|r\"\n    else\n        return colorCode .. math.floor(multi / 1000) / 1000 / 3 .. \"m/с|r\"\n    end\nend",
["alpha"] = 1,
["width"] = 50,
["color"] = {
1,
1,
1,
1,
},
["config"] = {
},
