["preferToUpdate"] = false,
["customText"] = "function()\n    local colorCodeOne = \"|cFFf5ff71\"\n    local colorCodeTwo = \"|cFFff4b56\"\n    local coreText = \"Аддон \"\n    local addonText = \"EmityCore \"\n    local errorText = \"не установлен/не включен\"\n    \n    return coreText .. colorCodeOne .. addonText .. \"|r\" .. colorCodeTwo .. errorText .. \"|r\"\nend",
