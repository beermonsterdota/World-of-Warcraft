},
["finish"] = {
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.spell = {\n    [123707] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 1\naura_env.cdWindow = 10\naura_env.castTime = 3\naura_env.cdAfterPhase = 23\naura_env.phaseOne = true\naura_env.msgPhaseOne = {\n    [\"Богомолы подчиняются мне, глупцы. Смотрите, как она делает то, что я говорю.\"] = 0,\n    [\"Ты должна уничтожить этих чужаков, императрица! Они пришли, чтобы поработить твой народ!\"] = 0,\n}\naura_env.msgPhaseTwo = {\n    [\"Еще... Еще! Мне нужно больше!\"] = 0,\n    [\"Власть... Я хочу больше власти! Стража! Защищайте вашу императрицу!\"] = 0,\n}\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer, 'SCHEDULED_WARNING', aura_env.id)\nend",
["do_custom"] = true,
},
