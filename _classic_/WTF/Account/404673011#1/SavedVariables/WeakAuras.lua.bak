["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["spark"] = false,
["sparkRotation"] = 0,
["sparkRotationMode"] = "AUTO",
["url"] = "https://wago.io/X2r68vxMW/64",
["backgroundColor"] = {
0,
0,
0,
0.5,
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["events"] = "EMITY_EYE, EMITY_EYE_TARGET",
["custom"] = "function(allstates, event, ...)\n    \n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            tar = UnitGUID(\"player\"),\n        }\n    end\n    \n    if event == \"EMITY_EYE\" then\n        local sourceGUID = ...\n        allstates[sourceGUID] = {\n            show = true,\n            changed = true,\n            duration = 3,\n            expirationTime = 3 + GetTime(),\n            progressType = \"timed\",\n            tar = nil,\n            autoHide = true,\n        }\n        return true\n    end\n    \n    if event == \"EMITY_EYE_TARGET\" then\n        local sourceGUID, destGUID = ...\n        for guid, state in pairs(allstates) do\n            if guid == sourceGUID then\n                state.tar = destGUID\n                state.changed = true\n            end\n        end\n        return true\n    end\n    \n    \n    \nend",
["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["subeventPrefix"] = "SPELL",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["events"] = "CLEU:SPELL_CAST_START",
["custom_type"] = "stateupdate",
["check"] = "event",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,_,_,_,_,spellId)\n    \n    if not aura_env.spell[spellId] then\n        return false\n    end\n    \n    if subEvent == \"SPELL_CAST_START\" then\n        WeakAuras.ScanEvents(\"EMITY_EYE\", sourceGUID)\n        C_Timer.After(0.25, function()\n                local unit = \"boss1\"\n                if UnitExists(unit) and UnitGUID(unit) == sourceGUID then \n                    WeakAuras.ScanEvents(\"EMITY_EYE_TARGET\", sourceGUID, UnitGUID(unit..\"target\"))\n                end\n        end)\n        return true\n    end\nend",
["custom_hide"] = "timed",
["unit"] = "player",
},
