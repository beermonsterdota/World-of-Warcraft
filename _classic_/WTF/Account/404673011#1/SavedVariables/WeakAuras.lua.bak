 = \"|cffff7c0aКот|r\",\n    [25] = \"|cff00FF98ВВ|r\",\n    [26] = \"|cff2359ffЭлем|r\",\n    [27] = \"|cffff7c0aСова|r\",\n    [28] = \"|cff68ccefФаер|r\",\n    [29] = \"|cff68ccefАркан|r\",\n    [30] = \"|cff68ccefФрост|r\",\n    [31] = \"|cff9382c9Афли|r\",\n    [32] = \"|cff9382c9Демон|r\",\n    [33] = \"|cff9382c9Дестр|r\",\n    [34] = \"|cfff0ebe0ШП|r\",\n}\n\naura_env.boe = {\n    [86850] = 0,\n    [86844] = 0,\n    [86841] = 0,\n    [86845] = 0,\n    [86843] = 0,\n    [86847] = 0,\n    [86842] = 0,\n    [86846] = 0,\n    [86849] = 0,\n    [86848] = 0,\n    [86192] = 0,\n    [86186] = 0,\n    [86183] = 0,\n    [86187] = 0,\n    [86185] = 0,\n    [86189] = 0,\n    [86184] = 0,\n    [86188] = 0,\n    [86191] = 0,\n    [86190] = 0,\n}\n\naura_env.ExtractBonusLootDetails = function(msg)\n    if not msg then return nil end\n    \n    local selfPattern = string.gsub(LOOT_ITEM_BONUS_ROLL_SELF, \"%%s\", \"(.+)\")\n    local match = string.match(msg, selfPattern)\n    if match then\n        return UnitName(\"player\"), match\n    end\n    \n    local pattern = string.gsub(LOOT_ITEM_BONUS_ROLL, \"%%s\", \"(.+)\", 1)\n    pattern = string.gsub(pattern, \"%%s\", \"(.+)\")\n    local name, item = string.match(msg, pattern)\n    return name, item\nend",
