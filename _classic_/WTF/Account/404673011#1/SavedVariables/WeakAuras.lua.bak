["tocversion"] = 50500,
["id"] = "ПМШ: Иконка Треш - Прокалывание",
["customText"] = "function()\n    local multi = 10000 -- 25 гер\n    local _, _, difficultyID = GetInstanceInfo()\n    -- 3 = 10 Нормал; 4 = 25 Нормал; 5 = 10 Героик; 6 = 25 Героик; 17 = ЛФР\n    if difficultyID == 3 then\n        multi =  10000\n    elseif difficultyID == 4 then\n        multi = 10000\n    elseif difficultyID == 5 then\n        multi = 10000\n    elseif difficultyID == 17 then\n        multi = 6500\n    end\n    local colorCode = \"|cFFfff468\"\n    \n    if multi * aura_env.state.stacks / 1000 / 2 < 1000 then\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000 / 2) .. \"k/с|r\"\n    else\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000) / 1000 / 2 .. \"m/с|r\"\n    end\nend",
