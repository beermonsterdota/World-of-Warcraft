["unit"] = "player",
["events"] = "TRIGGER:2",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"player\"] = {\n            show = true,\n            changed = true,\n            unit = \"player\",\n        }\n        return true\n    end\n    \n    if event == \"TRIGGER\" then\n        local triggerNum, triggerStates = ...\n        if not triggerStates then \n            return false \n        end\n        \n        if triggerNum == 2 then\n            for _, state in pairs(triggerStates) do\n                local isDread = state.spellId == 132007\n                allstates[\"\"] = {\n                    show = state.active,\n                    changed = true,\n                    unit = \"boss1target\",\n                    isDread = isDread,\n                    icon = isDread and 425957 or 651090\n                }\n                return true\n            end\n        end\n    end\nend",
