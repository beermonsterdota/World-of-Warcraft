["ТВВ: Автометки Лэй Ши - Жуткий туман"] = {
["outline"] = "OUTLINE",
["wagoID"] = "X2r68vxMW",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/X2r68vxMW/64",
["actions"] = {
["start"] = {
["custom"] = "if aura_env.state and aura_env.state.unit then\n    local priority = {8, 7, 3}\n    for _, mark in ipairs(priority) do\n        if aura_env.marks[mark] then\n            SetRaidTarget(aura_env.state.unit, mark)\n            aura_env.marks[mark] = false\n            break\n        end\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "if aura_env.state and aura_env.state.unit then\n    local currentMark = GetRaidTargetIndex(aura_env.state.unit)\n    if currentMark then\n        SetRaidTarget(aura_env.state.unit, 0)\n        aura_env.marks[currentMark] = true\n    end\nend",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.marks = {\n    [2] = true, -- Круг\n    [3] = true, -- Ромб\n    [6] = true, -- Квадрат\n}",
["do_custom"] = true,
},
