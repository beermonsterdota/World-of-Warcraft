},
["custom"] = "function(allstates, event, extra)\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id then\n            aura_env.count = aura_env.count + 1\n            local nextTimer = aura_env.rageTimers[aura_env.count] or aura_env.cdWindow\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = nextTimer,\n                expirationTime = GetTime() + nextTimer,\n                progressType = \"timed\",\n            }\n            aura_env.ScheduleWarning(nextTimer)\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        local nextTimer = aura_env.rageTimers[aura_env.count] or aura_env.cdWindow\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = nextTimer,\n            expirationTime = GetTime() + nextTimer,\n            progressType = \"timed\",\n        }\n        aura_env.ScheduleWarning(nextTimer)\n        return true\n    end\nend",
