["mirror"] = false,
["fixedWidth"] = 200,
["customText"] = "function()\n    if aura_env.count == 0 then\n        if aura_env.phaseOne == true then\n            return \"\", \"\"\n        else\n            return \"\", aura_env.buffCount\n        end\n    else\n        if aura_env.phaseOne == true then\n            return aura_env.count, \"\"\n        else\n            return aura_env.count, aura_env.buffCount\n        end\n    end\nend\n\n\n",
["displayText"] = "ПРОБИТЬ ЩИТ\nБИТЬ ОГНИСА",
