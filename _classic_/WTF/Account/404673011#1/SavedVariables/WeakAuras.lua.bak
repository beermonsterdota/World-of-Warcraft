["custom"] = "function(allstates, event, extra, subEvent,_,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        \n        if extra and extra:find(\"обнаруживает под собой\") then\n            return false\n        end\n        \n        if extra and extra:find(\"spell:122774\") then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                autoHide = true,\n                duration = aura_env.castTime,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        return true\n    end\nend",
