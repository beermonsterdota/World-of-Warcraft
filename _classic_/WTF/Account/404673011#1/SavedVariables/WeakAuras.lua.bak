["cooldownTextDisabled"] = false,
["auto"] = true,
["tocversion"] = 50500,
["id"] = "CC: Иконка Шек'зир - Ядовитая бомба",
["customText"] = "function()\n    local multi = 15000 -- 25 гер\n    local _, _, difficultyID = GetInstanceInfo()\n    -- 3 = 10 Нормал; 4 = 25 Нормал; 5 = 10 Героик; 6 = 25 Героик; 17 = ЛФР\n    if difficultyID == 3 then\n        multi =  10000\n    elseif difficultyID == 4 then\n        multi = 10000\n    elseif difficultyID == 5 then\n        multi = 15000\n    elseif difficultyID == 17 then\n        multi = 6000\n    end\n    local colorCode = \"|cFFfff468\"\n    \n    if multi * aura_env.state.stacks / 1000 / 2 < 1000 then\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000 / 2) .. \"k/с|r\"\n    else\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000) / 1000 / 2 .. \"m/с|r\"\n    end\nend",
["alpha"] = 1,
["width"] = 50,
["color"] = {
1,
1,
1,
1,
},
["config"] = {
},
["BFgloss"] = 0,
["useTooltip"] = false,
["displayIcon"] = "",
["cooldown"] = false,
["iconInset"] = 0,
},
