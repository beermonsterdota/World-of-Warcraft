["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = "Interface\\Addons\\EmityCore\\sound\\ShieldSoon.mp3",
["do_sound"] = true,
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.spell = {\n    [117961] = 0,\n}\naura_env.spellPhase = {\n    [118205] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 40\naura_env.cdWindow = 43\naura_env.phase = false\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer - 4, 'SCHEDULED_WARNING', aura_env.id)\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "10",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED, CLEU:SPELL_CAST_START, SCHEDULED_WARNING",
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = \"Interface\\\\Icons\\\\Ability_Warrior_ShieldMastery\",\n            count = math.random(1,3)\n        }\n        return true \n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                aura_env.count = aura_env.count + 1\n                aura_env.ScheduleWarning(aura_env.cdWindow)\n                if allstates[\"\"] then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                    return true\n                end\n            end\n        end\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spellPhase[spellIdS] then\n            return false\n        end\n        \n        aura_env.phase = false\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id and aura_env.phase == true then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 4,\n                expirationTime = GetTime() + 4,\n                progressType = \"timed\",\n                icon = \"Interface\\\\Icons\\\\Ability_Warrior_ShieldMastery\",\n                count = aura_env.count,\n            }\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        aura_env.phase = true\n        aura_env.ScheduleWarning(aura_env.cdStart)\n        return true\n    end\nend",
["spellIds"] = {
},
