["finish"] = {
["do_custom"] = false,
},
["init"] = {
["custom"] = "aura_env.spell = {\n    [116364] = 0,\n}\naura_env.spellPhase = {\n    [122410] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 17\naura_env.cdWindow = 34\naura_env.castTime = 8\naura_env.phase = false\n\naura_env.msgPhaseArcane = {\n    [\"О, великий мыслитель! Да снизойдет на меня твоя древняя мудрость!\"] = 0,\n}\naura_env.msgPhaseFire = {\n    [\"О, превозносимый! Моими руками ты отделишь их плоть от костей!\"] = 0,\n}\naura_env.msgPhaseNature = {\n    [\"О, великий дух! Даруй мне силу земли!\"] = 0,\n}\naura_env.msgPhaseShadow = {\n    [\"Великие души защитников! Охраняйте меня!\"] = 0,\n}\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer, 'SCHEDULED_WARNING', aura_env.id)\nend",
["do_custom"] = true,
},
