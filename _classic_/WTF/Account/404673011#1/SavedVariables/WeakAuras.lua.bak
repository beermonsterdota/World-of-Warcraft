["actions"] = {
["start"] = {
["glow_frame_type"] = "UNITFRAME",
["message_custom"] = "",
["glow_action"] = "show",
["do_message"] = false,
["do_glow"] = false,
["do_sound"] = false,
["glow_type"] = "Pixel",
["sound"] = " custom",
["glow_lines"] = 10,
["glow_thickness"] = 4,
["message_type"] = "SAY",
["message"] = "",
["custom"] = "",
["message_format_n_format"] = "none",
["message_format_c_format"] = "none",
["use_glow_color"] = true,
["glow_color"] = {
