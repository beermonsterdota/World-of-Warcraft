["names"] = {
},
["events"] = "CLEU:SPELL_AURA_REMOVED, CLEU:SPELL_CAST_START, UNIT_SPELLCAST_SUCCEEDED",
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 2,\n                expirationTime = GetTime() + 2,\n                progressType = \"timed\"\n            }\n            return true\n        end\n        \n        if subEvent == \"SPELL_AURA_REMOVED\" then\n            allstates[\"\"] = {\n                show = false,\n                changed = true,\n            }\n            return true\n        end\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spellPhase[spellIdS] then\n            return false\n        end\n        \n        if extra ~= \"boss1\" and extra ~= \"boss2\" and extra ~= \"boss3\" then\n            return false\n        end\n        \n        local guid = UnitGUID(extra)\n        local npcId = select(6, strsplit(\"-\", guid))\n        \n        if npcId == \"60709\" then -- Qiang\n            allstates[\"\"] = {\n                show = false,\n                changed = true,\n            }\n            return true\n        end\n    end\nend",
