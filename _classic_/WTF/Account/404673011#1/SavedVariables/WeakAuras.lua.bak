["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        \n        if extra and extra:find(\"обнаруживает под собой\") then\n            return false\n        end\n        \n        if extra and extra:find(\"spell:122774\") then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.castTime,\n                expirationTime = GetTime() + aura_env.castTime,\n                progressType = \"timed\",\n                status = \"isCasting\"\n            }\n            aura_env.ScheduleWarning(aura_env.castTime)\n            return true\n        end\n        \n        if extra and extra:find(\"начинает трескаться и расползаться!\") then\n            allstates[\"\"] = {\n                show = false,\n                changed = true,\n            }\n            return true\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id then\n            aura_env.count = aura_env.count + 1\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdWindow - aura_env.castTime,\n                expirationTime = GetTime() + aura_env.cdWindow - aura_env.castTime,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = aura_env.cdStart,\n            expirationTime = GetTime() + aura_env.cdStart,\n            progressType = \"timed\",\n            status = \"onCD\"\n        }\n        return true\n    end\n    \nend",
["events"] = "ENCOUNTER_START, RAID_BOSS_EMOTE, SCHEDULED_WARNING",
