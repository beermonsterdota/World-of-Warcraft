["auto"] = true,
["tocversion"] = 50500,
["id"] = "СС: Иконка Треш - Гибельное кровопускание",
["customText"] = "function()\n    local multi = 12500 -- 25 гер\n    local _, _, difficultyID = GetInstanceInfo()\n    -- 3 = 10 Нормал; 4 = 25 Нормал; 5 = 10 Героик; 6 = 25 Героик; 17 = ЛФР\n    if difficultyID == 3 then\n        multi =  7500\n    elseif difficultyID == 4 then\n        multi = 12500\n    elseif difficultyID == 5 then\n        multi = 7500\n    elseif difficultyID == 17 then\n        multi = 8125\n    end\n    local colorCode = \"|cFFfff468\"\n    \n    if multi * aura_env.state.stacks / 1000 / 3 < 1000 then\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000 / 3) .. \"k/с|r\"\n    else\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000) / 1000 / 3 .. \"m/с|r\"\n    end\nend",
["alpha"] = 1,
