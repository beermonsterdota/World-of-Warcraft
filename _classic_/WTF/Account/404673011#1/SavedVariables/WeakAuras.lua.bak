},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates,event,guid,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId)\n    \n    if (subEvent == \"SPELL_DAMAGE\" or subEvent == \"SPELL_MISSED\") and spellId == aura_env.spellId then\n        if not aura_env.guids[sourceGUID] then\n            aura_env.guids[sourceGUID] = true\n            if allstates[\"\"] then\n                allstates[\"\"].value = allstates[\"\"].value + 1\n                allstates[\"\"].changed = true\n            else\n                allstates[\"\"] = {\n                    progressType = \"static\",\n                    value = 1,\n                    show = true,\n                    changed = true,\n                }\n            end\n            return true\n        end\n    end\n    \n    if subEvent == \"UNIT_DIED\" then\n        local npcId = select(6, strsplit(\"-\", destGUID))\n        if npcId == \"60940\" or npcId == \"60184\" then\n            local message = 'ADD'\n            C_ChatInfo.SendAddonMessage('EMITY', message, 'RAID')\n            if allstates[\"\"] and allstates[\"\"].value > 0 then\n                allstates[\"\"].value = allstates[\"\"].value - 1\n                allstates[\"\"].changed = true\n                if allstates[\"\"].value == 0 then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                end\n                return true\n            end\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        wipe(aura_env.guids)\n    end\n    return false\nend",
["custom_type"] = "stateupdate",
["check"] = "event",
["subeventPrefix"] = "SPELL",
["events"] = "ENCOUNTER_START, CLEU:SPELL_DAMAGE:SPELL_MISSED:UNIT_DIED",
["debuffType"] = "HELPFUL",
