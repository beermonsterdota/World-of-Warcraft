["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,sourceName,_,_,destGUID,destName,_,_,spellId)\n    \n    if subEvent == \"SPELL_CAST_START\" and spellId == 117628 then\n        allstates[\"\"] = {\n            progressType = \"timed\",\n            duration = 2,\n            expirationTime = GetTime() + 2,\n            autoHide = true,\n            show = true,\n            changed = true,\n            state = \"Casting\",\n            interrupter = \"\",\n        }\n        return true\n    elseif subEvent == \"SPELL_INTERRUPT\" then\n        if allstates[\"\"] then\n            allstates[\"\"].duration = 1.25\n            allstates[\"\"].expirationTime = GetTime() + 1.25\n            allstates[\"\"].changed = true\n            allstates[\"\"].state = \"Kicked\"\n            allstates[\"\"].interrupter = sourceName\n            return true\n        end\n    end\nend",
