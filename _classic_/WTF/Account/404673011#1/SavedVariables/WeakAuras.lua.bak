["custom"] = "function(allstates, event, _, subEvent,_,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                autoHide = true,\n                duration = aura_env.castTime,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\n    \n    \n    if event == \"ENCOUNTER_START\" then\n        local  _, _, difficultyID = GetInstanceInfo()\n        if difficultyID == 5 or difficultyID == 6 then\n            aura_env.castTime = 2.5\n        else\n            aura_env.castTime = 3\n        end\n        return true\n    end\nend",
