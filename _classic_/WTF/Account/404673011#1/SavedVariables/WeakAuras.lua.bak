["wagoID"] = "X2r68vxMW",
["parent"] = "Т14 Тексты: Все боссы",
["displayText"] = "%c",
["customText"] = "function()\n    local icon = \"Interface\\\\Icons\\\\Spell_Shaman_StaticShock\"\n    local iconSetting = \":0:0:0:0:64:64:4:60:4:60\"\n    local text = \"АДД \"\n    return \"|T\" .. icon .. iconSetting .. \"|t \" .. text .. \"|T\" ..  icon .. iconSetting .. \"|t\"\nend\n\n\n",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
