["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spell = {\n    [122770] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 16\naura_env.cdWindow = 16\naura_env.msgDayVar1 = \"Ночь... становится... днем!\"\naura_env.msgDayVar2 = \"Солнце... сияет...\"\naura_env.msgDayVar3 = \"И снова... рассвет...\"\naura_env.msgNightVar1 = \"Ночь побеждает день...\"\naura_env.msgNightVar2 = \"Свет меркнет...\"\naura_env.msgNightVar3 = \"Тьма сгущается...\"\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer - 5, 'SCHEDULED_WARNING', aura_env.id)\nend",
