["custom"] = "local locale = GetLocale()\nif locale == \"ruRU\" then\n    aura_env.armor = {\n        [\"Латы\"] = \"Латы\",\n        [\"Кольчуга\"] = \"Кольчуга\",\n        [\"Кожа\"] = \"Кожа\",\n        [\"Ткань\"] = \"Ткань\",\n    }\nelse\n    aura_env.armor = {\n        [\"Plate\"] = \"Латы\",\n        [\"Mail\"] = \"Кольчуга\",\n        [\"Leather\"] = \"Кожа\",\n        [\"Cloth\"] = \"Ткань\",\n    }\nend\n\naura_env.slot = {\n    [1] = \"Голова\",\n    [2] = \"Шея\",\n    [3] = \"Плечи\",\n    [4] = \"Плащ\",\n    [5] = \"Грудь\",\n    [6] = \"Наручи\",\n    [7] = \"Перчатки\",\n    [8] = \"Пояс\",\n    [9] = \"Ноги\",\n    [10] = \"Ступни\",\n    [11] = \"Кольцо\",\n    [12] = \"Тринька\",\n    [13] = \"Ружье\",\n    [14] = \"Лук\",\n    [15] = \"Посох\",\n    [16] = \"Меч, Двуручный\",\n    [17] = \"Меч, Одноручный\",\n    [18] = \"Дробящее, Двуручное\",\n    [19] = \"Дробящее, Одноручное\",\n    [20] = \"Топор, Двуручный\",\n    [21] = \"Топор, Одноручный\",\n    [22] = \"Кистевое\",\n    [23] = \"Кинжал\",\n    [24] = \"Левая рука\",\n    [25] = \"Щит\",\n    [26] = \"Метательное\",\n    [27] = \"Арбалет\",\n    [28] = \"Древковое\",\n    [29] = \"Жезл\",\n    [30] = \"Маунт\",\n    [31] = \"Токен, Ноги - |cfff58cbaПал|r, |cfff0ebe0Прист|r, |cff9382c9Лок|r\",\n    [32] = \"Токен, Ноги - |cffc69b6dВар|r, |cffaad372Хант|r, |cff2359ffШам|r, |cff00FF98Монк|r\",\n    [33] = \"Токен, Ноги - |cfffff468Рога|r, |cffc41e3bДК|r, |cff68ccefМаг|r, |cffff7c0aДруид|r\",\n    [34] = \"Токен, Перчатки - |cfff58cbaПал|r, |cfff0ebe0Прист|r, |cff9382c9Лок|r\",\n    [35] = \"Токен, Перчатки - |cffc69b6dВар|r, |cffaad372Хант|r, |cff2359ffШам|, |cff00FF98Монк|rr\",\n    [36] = \"Токен, Перчатки - |cfffff468Рога|r, |cffc41e3bДК|r, |cff68ccefМаг|r, |cffff7c0aДруид|r\",\n    [37] = \"Токен, Плечи - |cfff58cbaПал|r, |cfff0ebe0Прист|r, |cff9382c9Лок|r\",\n    [38] = \"Токен, Плечи - |cffc69b6dВар|r, |cffaad372Хант|r, |cff2359ffШам|r, |cff00FF98Монк|r\",\n    [39] = \"Токен, Плечи