["events"] = "WA_EMITY_TIMER, ZONE_CHANGED_NEW_AREA",
["custom"] = "function(a, e, ...)\n    \n    if e == \"ZONE_CHANGED_NEW_AREA\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 0.1,\n            expirationTime = GetTime() + 0.1,\n            autoHide = true\n        }\n        return true\n    end\n    \n    if e == \"WA_EMITY_TIMER\" then\n        local key, time, count, guid, name = ...\n        if key == \"UNSOK_AMBER_EXPLOSION_PLAYER_\" .. aura_env.key then\n            if time then\n                if time > 0 then\n                    if not a[name] then\n                        a[name] = {\n                            show = true,\n                            changed = true,\n                            progressType = \"static\",\n                            value = 1,\n                            total = 1,\n                        }\n                        return true\n                    end\n                end\n            else\n                if a[name] then\n                    a[name].show = false\n                    a[name].changed = true\n                    return true\n                end\n            end\n        end\n    end\nend",
