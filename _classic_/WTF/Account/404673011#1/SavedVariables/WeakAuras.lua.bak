["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spell[spellIdS] and not aura_env.spellStart[spellIdS] then\n            return false\n        end\n        \n        if aura_env.spell[spellIdS] then\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.castTime,\n                expirationTime = GetTime() + aura_env.castTime,\n                progressType = \"timed\",\n                status = \"isCasting\"\n            }\n            aura_env.ScheduleWarning(aura_env.castTime)\n            return true\n        end\n        \n        if aura_env.spellStart[spellIdS] then\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n        \n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdWindow - aura_env.castTime,\n                expirationTime = GetTime() + aura_env.cdWindow - aura_env.castTime,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n    end\nend",
["events"] = "UNIT_SPELLCAST_SUCCEEDED, SCHEDULED_WARNING, CLEU:SPELL_AURA_APPLIED",
