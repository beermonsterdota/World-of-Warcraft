["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS, sourceGUID,_,_,_, destGUID,_,_,_, spellId)\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spellPhase[spellIdS] and not aura_env.spellLastCopy[spellIdS] then\n            return false\n        end\n        \n        if aura_env.spellPhase[spellIdS] then\n            aura_env.spellActive = true\n            aura_env.count = 1\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n        \n        if aura_env.spellLastCopy[spellIdS] then\n            aura_env.spellActive = true\n            aura_env.count = 1\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdAfterPhase,\n                expirationTime = GetTime() + aura_env.cdAfterPhase,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if aura_env.NPCs[npcID] then\n                aura_env.spellActive = false\n                if allstates[\"\"] then\n                    allstates[\"\"] = {\n                        show = false,\n                        changed = true,\n                        status = \"onCD\"\n                    }\n                    return true\n                end\n            end\n        end\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        local npcID = select(6, strsplit(\"-\", sourceGUID))\n        \n        if subEvent == \"SPELL_CAST_START\" and aura_env.NPCs[npcID] then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.castTime,\n                expirationTime = GetTime() + aura_env.castTime,\n                progressType = \"timed\",\n                status = \"isCasting\"\n            }\n            aura_env.ScheduleWarning(aura_env.castTime)\n            return true\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id then\n            if aura_env.spellActive == true then\n                aura_env.count = aura_env.count + 1\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.cdWindow - aura_env.castTime,\n                    expirationTime = GetTime() + aura_env.cdWindow - aura_env.castTime,\n                    progressType = \"timed\",\n                    status = \"onCD\"\n                }\n                return true\n            end\n        end\n    end\nend",
