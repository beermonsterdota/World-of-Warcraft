["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS, sourceGUID,_,_,_, destGUID,_,_,_, spellId)\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spell[spellIdS] then\n            return false\n        end\n        \n        allstates[\"\"] = {\n            show = false,\n            changed = true,\n        }\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spellPhase[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\nend\n\n\n\n",
["events"] = "UNIT_SPELLCAST_SUCCEEDED, CLEU:SPELL_CAST_SUCCESS",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = true,\n}",
