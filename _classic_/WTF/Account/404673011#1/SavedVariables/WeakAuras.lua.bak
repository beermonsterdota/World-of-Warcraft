["custom"] = "function(a, e, ...)\n    if e == \"OPTIONS\" then\n        a[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = GetTime() + 15,\n        }\n        return true\n    end\n    \n    if e == \"WA_EMITY_TIMER\" then\n        local key, time, count, guid = ...\n        if key == \"UNSOK_AMBER_EXPLOSION_PLAYER_\" .. aura_env.key then\n            if time then\n                if time > 0 then\n                    aura_env.expirationTime = GetTime() + time\n                    \n                    a[guid] = {\n                        show = true,\n                        changed = true,\n                        progressType = \"timed\",\n                        duration = time,\n                        expirationTime = aura_env.expirationTime,\n                        status = \"CD\",\n                    }\n                    return true\n                end\n            else\n                if a[guid] then\n                    a[guid].show = false\n                    a[guid].changed = true\n                    return true\n                end\n            end\n        end\n    end\nend",
