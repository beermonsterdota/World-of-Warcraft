["actions"] = {
["start"] = {
["sound"] = " KitID",
["custom"] = "if not aura_env.antispam or GetTime() - aura_env.antispam > 60 then\n    aura_env.antispam = GetTime()\n    PlaySoundFile(\"Interface\\\\AddOns\\\\EmityCore\\\\sound\\\\Left.mp3\", \"Master\")\nend\naura_env.mobActive = true\n\n\n",
