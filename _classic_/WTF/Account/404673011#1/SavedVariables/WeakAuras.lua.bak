},
["custom"] = "function(allstates, event, extra)\n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        if extra and extra == aura_env.msgPhase then\n            aura_env.count = 1\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\n    \n    if event == \"RAID_BOSS_EMOTE\" then\n        if extra and extra:find(aura_env.msgText) then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                aura_env.count = aura_env.count + 1\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.cdWindow,\n                    expirationTime = GetTime() + aura_env.cdWindow,\n                    progressType = \"timed\",\n                }\n                return true\n            end\n        end\n    end\nend",
