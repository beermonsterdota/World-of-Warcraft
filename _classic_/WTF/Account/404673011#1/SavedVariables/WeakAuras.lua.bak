},
["init"] = {
["custom"] = "aura_env.spell = {\n    [116417] = 0,\n}\naura_env.spellPhase = {\n    [122410] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 14\naura_env.cdWindow = 14\n\naura_env.msgPhaseArcane = {\n    [\"О, великий мыслитель! Да снизойдет на меня твоя древняя мудрость!\"] = 0,\n}\naura_env.msgPhaseFire = {\n    [\"О, превозносимый! Моими руками ты отделишь их плоть от костей!\"] = 0,\n}\naura_env.msgPhaseNature = {\n    [\"О, великий дух! Даруй мне силу земли!\"] = 0,\n}\naura_env.msgPhaseShadow = {\n    [\"Великие души защитников! Охраняйте меня!\"] = 0,\n}\n\n\n",
["do_custom"] = true,
},
