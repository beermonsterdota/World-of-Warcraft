},
["slantMode"] = "INSIDE",
["customText"] = "function()\n    local icon = aura_env.icon\n    local iconSetting = \":0:0:0:0:64:64:4:60:4:60\"\n    local text = aura_env.text\n    return \"|T\" .. icon .. iconSetting .. \"|t \" .. text .. \" |T\" ..  icon .. iconSetting .. \"|t\"\nend\n\n\n",
["shadowYOffset"] = -1,
["justify"] = "CENTER",
["desaturateBackground"] = false,
["cooldownSwipe"] = true,
["sparkBlendMode"] = "ADD",
["customTextUpdate"] = "event",
["cooldownEdge"] = true,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["event"] = "Health",
["unit"] = "player",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_REMOVED, CLEU:SPELL_AURA_APPLIED, CLEU:SPELL_CAST_SUCCESS",
["custom"] = "function(allstates, event, extra, subEvent, spellIdS, sourceGUID,_,_,_, destGUID,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] and not aura_env.spellIn[spellId] and not aura_env.spellOut[spellId] and not aura_env.spellBuff[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" and aura_env.spell[spellId] then\n            local npcID = select(6, strsplit(\"-\", sourceGUID))\n            if aura_env.NPCs[npcID] then\n                if aura_env.onPlatform == true then\n                    if aura_env.mobActive == true then\n                        aura_env.count = aura_env.count + 1\n                        if aura_env.count == 4 then\n                            aura_env.text = \"СТОЙ СПРАВА\"\n                            aura_env.icon = \"Interface\\\\Icons\\\\misc_arrowright\"\n                            PlaySoundFile(\"Interface\\\\AddOns\\\\EmityCore\\\\sound\\\\Right.mp3\", \"Master\")\n                            WeakAuras.ScanEvents(\"EMITY_SHA_LEFT_RIGHT\")\n                            allstates[\"\"] = {\n                                show = true,\n                                changed = true,\n                                duration = 7,\n                                expirationTime = GetTime() + 7,\n                                progressType = \"timed\",\n                            }\n                            return true\n                        end\n                    end\n                end\n            end\n        end\n        \n        if subEvent == \"SPELL_AURA_REMOVED\" and aura_env.spellBuff[spellId] then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if aura_env.NPCs[npcID] then\n                if aura_env.onPlatform == true then\n                    if aura_env.mobActive == true then\n                        aura_env.count = 0\n                        aura_env.text = \"СТОЙ В ЦЕНТРЕ\"\n                        aura_env.icon = \"Interface\\\\Icons\\\\misc_arrowdown\"\n                        PlaySoundFile(\"Interface\\\\AddOns\\\\EmityCore\\\\sound\\\\StayCenter.mp3\", \"Master\")\n                        WeakAuras.ScanEvents(\"EMITY_SHA_LEFT_CENTER\")\n                        allstates[\"\"] = {\n                            show = true,\n                            changed = true,\n                            duration = 14,\n                            expirationTime = GetTime() + 14,\n                            progressType = \"timed\",\n                        }\n                        return true\n                    end\n                end\n            end\n        end\n        \n        if subEvent == \"SPELL_AURA_REMOVED\" and aura_env.spellIn[spellId] then\n            if destGUID ~= WeakAuras.myGUID then\n                return false\n            end\n            aura_env.onPlatform = true\n            aura_env.count = 0\n            aura_env.text = \"СТОЙ В ЦЕНТРЕ\"\n            aura_env.icon = \"Interface\\\\Icons\\\\misc_arrowdown\"\n            WeakAuras.ScanEvents(\"EMITY_SHA_LEFT_CENTER\")\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 11,\n                expirationTime = GetTime() + 11,\n                progressType = \"timed\",\n            }\n            return true\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" and aura_env.spellBuff[spellId] then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if aura_env.NPCs[npcID] then\n                if aura_env.onPlatform == true then\n                    aura_env.count = 0\n                    aura_env.text = \"СТОЙ В ЦЕНТРЕ\"\n                    aura_env.icon = \"Interface\\\\Icons\\\\misc_arrowdown\"\n                    WeakAuras.ScanEvents(\"EMITY_SHA_LEFT_CENTER\")\n                    return true\n                end\n            end\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" and aura_env.spellOut[spellId] then\n            if destGUID ~= WeakAuras.myGUID then\n                return false\n            end\n            aura_env.count = 0\n            aura_env.onPlatform = false\n            aura_env.text = \"СТОЙ В ЦЕНТРЕ\"\n            aura_env.icon = \"Interface\\\\Icons\\\\misc_arrowdown\"\n            WeakAuras.ScanEvents(\"EMITY_SHA_LEFT_OFF\")\n            allstates[\"\"] = {\n                show = false,\n                changed = true,\n            }\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.onPlatform = false\n        aura_env.text = \"СТОЙ В ЦЕНТРЕ\"\n        aura_env.icon = \"Interface\\\\Icons\\\\misc_arrowdown\"\n        return true\n    end\nend\n\n\n\n",
["spellIds"] = {
},
["names"] = {
},
