["justify"] = "LEFT",
["icon"] = true,
["sparkHidden"] = "NEVER",
["customText"] = "function()\n    local multi = 50000 -- 25 гер\n    local _, _, difficultyID = GetInstanceInfo()\n    -- 3 = 10 Нормал; 4 = 25 Нормал; 5 = 10 Героик; 6 = 25 Героик; 17 = ЛФР\n    if difficultyID == 3 then\n        multi =  30000\n    elseif difficultyID == 4 then\n        multi = 30000\n    elseif difficultyID == 5 then\n        multi = 50000\n    elseif difficultyID == 17 then\n        multi = 20000\n    end\n    local colorCode = \"|cFFfff468\"\n    local colorCode2 = \"|cFF00e4ff(\"\n    if multi * aura_env.state.stacks / 1000 / 2 < 1000 then\n        return colorCode2 .. aura_env.state.stacks .. \")|r\" .. colorCode .. math.floor(multi * aura_env.state.stacks / 1000 / 2) .. \"k/с|r\"\n    else\n        return colorCode2 .. aura_env.state.stacks .. \")|r\" .. colorCode .. math.floor(multi * aura_env.state.stacks / 1000) / 1000 / 2 .. \"m/с|r\"\n    end\nend\n\n-- aura_env.count = aura_env.state.stacks\n\n--ТОЛЬКО ТЕКСТ\n--function()\n--local colorCode = \"|cFFfff468\"\n--return colorCode .. \"+100%|r\"\n--end\n\n--УЗНАТЬ ЗНАЧЕНИЕ ИЗ ДЕБАФА\n--function()\n--local colorCode = \"|cFFfff468\"\n--local damage = select(17, WA_GetUnitDebuff(\"player\", 105479)) or 1000\n--return colorCode .. math.floor(damage / 1000) .. \"k|r\"\n--end\n\n\n",
