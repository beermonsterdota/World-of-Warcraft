["events"] = "ENCOUNTER_START, CHAT_MSG_MONSTER_YELL, CLEU:SPELL_CAST_START",
["custom"] = "function(allstates, event, extra, subEvent,_,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                autoHide = true,\n                duration = aura_env.castTime,\n                expirationTime = GetTime() + aura_env.castTime,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        if extra and (extra == aura_env.msgNightVar1 or extra == aura_env.msgNightVar2 or extra == aura_env.msgNightVar3) then\n            aura_env.count = 1\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        return true\n    end\nend",
