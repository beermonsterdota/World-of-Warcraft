["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                aura_env.count = aura_env.count + 1\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.cdWindow,\n                    expirationTime = GetTime() + aura_env.cdWindow,\n                    progressType = \"timed\",\n                }\n                return true\n            end\n        end\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spellPhase[spellIdS] then\n            return false\n        end\n        \n        if extra ~= \"boss1\" and extra ~= \"boss2\" and extra ~= \"boss3\" then\n            return false\n        end\n        \n        local guid = UnitGUID(extra)\n        local npcId = select(6, strsplit(\"-\", guid))\n        \n        if npcId == \"60701\" then -- Zian\n            allstates[\"\"] = {\n                show = false,\n                changed = true,\n            }\n            return true\n        end\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        if extra and aura_env.msgPhase[extra] then\n            aura_env.count = 1\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n            }\n            return true\n        end\n    end\nend",
["events"] = "CHAT_MSG_MONSTER_YELL, CLEU:SPELL_CAST_SUCCESS, UNIT_SPELLCAST_SUCCEEDED",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = true,\n}",
