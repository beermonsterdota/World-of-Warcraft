["custom"] = "aura_env.spell = {\n    [122224] = 50, -- Пронзающее копье\n    [3355] = 60, -- Замораживающая ловушка\n    [51514] = 60, -- Сглаз\n    [2094] = 60, -- Ослепление\n    [6770] = 60, -- Ошеломление\n    [20066] = 60, -- Покаяние\n    [118] = 50, -- Превращение\n    [115078] = 40, -- Паралич\n    [19386] = 30, -- Укус виверны\n    [118699] = 20, -- Страх\n    --[82691] = 10, -- Кольцо мороза\n    --[5246] = 8, -- Устрашающий крик\n    --[105421] = 6, -- Слепящий свет\n    --[105593] = 6, -- Кулак правосудия\n    --[408] = 6, -- Удар по почкам\n    --[115001] = 6, -- Беспощадность зимы\n    --[117526] = 5, -- Связующий выстрел\n    --[5211] = 5, -- Мощное оглушение\n    --[118905] = 5, -- Статический заряд\n    --[91797] = 4, -- Чудовищный удар\n    --[1833] = 4, -- Подлый трюк\n    --[30283] = 3, -- Неистовство Тьмы\n    --[6789] = 3, -- Лик тлена\n    --[7922] = 1.5, -- Рывок и оглушение\n}\n\naura_env.NPCs = {\n    [\"62408\"] = true,\n    [\"62402\"] = true,\n    [\"62405\"] = true,\n}",
