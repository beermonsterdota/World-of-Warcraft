["actions"] = {
["start"] = {
["custom"] = "if aura_env.state and aura_env.state.unit then\n    local priority = {3}\n    for _, mark in ipairs(priority) do\n        if aura_env.marks[mark] then\n            SetRaidTarget(aura_env.state.unit, mark)\n            aura_env.marks[mark] = false\n            break\n        end\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["custom"] = "if aura_env.state and aura_env.state.unit then\n    local currentMark = GetRaidTargetIndex(aura_env.state.unit)\n    if currentMark then\n        SetRaidTarget(aura_env.state.unit, 0)\n        aura_env.marks[currentMark] = true\n    end\nend",
["do_custom"] = true,
},
["init"] = {
["custom"] = "aura_env.marks = {\n    [3] = true, -- Ромб\n}",
["do_custom"] = true,
