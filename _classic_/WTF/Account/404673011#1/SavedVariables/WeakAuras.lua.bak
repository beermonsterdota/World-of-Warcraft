["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.spell = {\n    [117708] = 0,\n}\naura_env.spellPhase = {\n    [118205] = 0,\n}\naura_env.cdStart = 45\naura_env.cdWindow = 49\naura_env.count = 1\naura_env.castTime = 2\naura_env.phaseCount = 1\naura_env.msgPhase = {\n    [\"Вы разгневали императора! Я ПРИГОВАРИВАЮ ВАС К СМЕРТИ!\"] = 0,\n}\n\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer, 'SCHEDULED_WARNING', aura_env.id)\nend",
