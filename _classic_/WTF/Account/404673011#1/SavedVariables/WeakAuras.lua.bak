["ПМШ: Текст Фэн - Вытягивающий щит (предупреждение)"] = {
["outline"] = "OUTLINE",
["wagoID"] = "X2r68vxMW",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "\n\n",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/X2r68vxMW/64",
["actions"] = {
["start"] = {
["sound"] = "Interface\\Addons\\EmityCore\\sound\\AddsSoon.mp3",
["do_sound"] = true,
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.spell = {\n    [117203] = 0,\n}\naura_env.spellPhase = {\n    [122410] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 5\naura_env.cdWindow = 35\naura_env.phase = false\naura_env.msgPhaseArcane = {\n    [\"О, великий мыслитель! Да снизойдет на меня твоя древняя мудрость!\"] = 0,\n}\naura_env.msgPhaseFire = {\n    [\"О, превозносимый! Моими руками ты отделишь их плоть от костей!\"] = 0,\n}\naura_env.msgPhaseNature = {\n    [\"О, великий дух! Даруй мне силу земли!\"] = 0,\n}\naura_env.msgPhaseShadow = {\n    [\"Великие души защитников! Охраняйте меня!\"] = 0,\n}\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer - 4, 'SCHEDULED_WARNING', aura_env.id)\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "10",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED, CHAT_MSG_MONSTER_YELL, SCHEDULED_WARNING",
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = \"Interface\\\\Icons\\\\Ability_Rogue_EnvelopingShadows\",\n            count = math.random(1,3)\n        }\n        return true \n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spell[spellIdS] and not aura_env.spellPhase[spellIdS] then\n            return false\n        end\n        \n        if aura_env.spell[spellIdS] then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                aura_env.count = aura_env.count + 1\n                aura_env.ScheduleWarning(aura_env.cdWindow)\n                if allstates[\"\"] then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                    return true\n                end\n            end\n        end\n        \n        if aura_env.spellPhase[spellIdS] then\n            \n            aura_env.phase = false\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n        \n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        \n        if extra and aura_env.msgPhaseShadow[extra] then\n            aura_env.count = 1\n            aura_env.phase = true\n            aura_env.ScheduleWarning(aura_env.cdStart)\n            return true\n        end\n        \n        if extra and (aura_env.msgPhaseArcane[extra] or aura_env.msgPhaseNature[extra] or aura_env.msgPhaseFire[extra]) then\n            aura_env.phase = false\n            if allstates[\"\"] then\n                allstates[\"\"].show = false\n                allstates[\"\"].changed = true\n                return true\n            end\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id and aura_env.phase == true then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 4,\n                expirationTime = GetTime() + 4,\n                progressType = \"timed\",\n                icon = \"Interface\\\\Icons\\\\Ability_Rogue_EnvelopingShadows\",\n                count = aura_env.count,\n            }\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        aura_env.phase = false\n        return true\n    end\nend",
["spellIds"] = {
},
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true,\n}",
