["ТВВ: Текст Защитники - Исторжение скверны"] = {
["outline"] = "OUTLINE",
["wagoID"] = "X2r68vxMW",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "\n\n",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/X2r68vxMW/64",
["actions"] = {
["start"] = {
["do_glow"] = false,
["sound"] = " KitID",
["do_sound"] = false,
},
["finish"] = {
},
["init"] = {
["custom"] = "aura_env.spell = {\n    [117975] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 7\naura_env.cdWindow = 40\naura_env.msgPhase = {\n    [\"Ничто не сравнится с моей силой!\"] = 0,\n}\n\naura_env.ScheduleWarning = function(timer)\n    if aura_env.scheduledTimer then WeakAuras.timer:CancelTimer(aura_env.scheduledTimer) end\n    aura_env.scheduledTimer = WeakAuras.timer:ScheduleTimer(WeakAuras.ScanEvents, timer - 4, 'SCHEDULED_WARNING', aura_env.id)\nend",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "10",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["events"] = "CLEU:SPELL_CAST_START, SCHEDULED_WARNING, CHAT_MSG_MONSTER_YELL",
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = \"Interface\\\\Icons\\\\spell_shadow_soulleech\",\n            count = math.random(1,3)\n        }\n        return true \n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                aura_env.count = aura_env.count + 1\n                aura_env.ScheduleWarning(aura_env.cdWindow)\n                if allstates[\"\"] then\n                    allstates[\"\"].show = false\n                    allstates[\"\"].changed = true\n                    return true\n                end\n            end\n        end\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        if extra and aura_env.msgPhase[extra] then\n            aura_env.count = 1\n            aura_env.ScheduleWarning(aura_env.cdStart)\n            return true\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id  then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = 4,\n                expirationTime = GetTime() + 4,\n                progressType = \"timed\",\n                icon = \"Interface\\\\Icons\\\\spell_shadow_soulleech\",\n                count = aura_env.count,\n            }\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["check"] = "event",
["subeventSuffix"] = "_CAST_START",
["customVariables"] = "{\n    expirationTime = true,\n}",
["custom_hide"] = "timed",
},
