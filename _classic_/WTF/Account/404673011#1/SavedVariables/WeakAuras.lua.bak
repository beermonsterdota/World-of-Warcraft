["trigger"] = {
["type"] = "custom",
["debuffType"] = "HELPFUL",
["custom_type"] = "stateupdate",
["subeventPrefix"] = "SPELL",
["duration"] = "10",
["event"] = "Health",
["unit"] = "player",
["names"] = {
},
["events"] = "CLEU:SPELL_AURA_APPLIED",
["custom"] = "function(allstates,event,_,subEvent,_,sourceGUID,_,_,_,destGUID,destName,_,_,spellId,_,_,_,amount)\n    \n    if event == \"OPTIONS\" then\n        aura_env.textNames = WA_ClassColorName(\"player\") .. \", \" .. WA_ClassColorName(\"player\") .. \", \" .. WA_ClassColorName(\"player\")\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            icon = \"Interface\\\\Icons\\\\spell_shadow_psychicscream\",\n        }\n        return true \n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 4 then\n                aura_env.antispam = GetTime()\n                aura_env.textNames = WA_ClassColorName(destName)\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = 3.5,\n                    expirationTime = GetTime() + 3,\n                    progressType = \"timed\",\n                    autoHide = true,\n                    icon = \"Interface\\\\Icons\\\\spell_shadow_psychicscream\",\n                }\n                return true \n            else\n                aura_env.textNames = aura_env.textNames .. \", \" .. WA_ClassColorName(destName)\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = 3.5,\n                    expirationTime = GetTime() + 3,\n                    progressType = \"timed\",\n                    autoHide = true,\n                    icon = \"Interface\\\\Icons\\\\spell_shadow_psychicscream\",\n                }\n                return true \n            end\n        end\n    end\nend\n\n\n\n\n\n",
["spellIds"] = {
},
