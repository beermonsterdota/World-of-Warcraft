["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS, sourceGUID,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if subEvent == \"SPELL_CAST_SUCCESS\" then\n            \n            if not aura_env.spell[spellId] then\n                return false\n            end\n            \n            if aura_env.spell[spellId] then\n                \n                allstates[sourceGUID] = {\n                    show = true,\n                    changed = true,\n                    autoHide = false,\n                    duration = aura_env.castTime,\n                    expirationTime = GetTime() + aura_env.castTime,\n                    progressType = \"timed\",\n                    status = \"isCasting\",\n                    tar = sourceGUID,\n                }\n                aura_env.ScheduleWarning(aura_env.castTime, sourceGUID)\n                return true\n            end\n        end\n    end\n    \n    \n    if event == 'SCHEDULED_WARNING' then\n        if allstates[extra] then\n            allstates[extra] = {\n                show = true,\n                changed = true,\n                autoHide = false,\n                duration = aura_env.cdWindow - aura_env.castTime,\n                expirationTime = GetTime() + aura_env.cdWindow - aura_env.castTime,\n                progressType = \"timed\",\n                status = \"onCD\",\n                tar = extra,\n            }\n            return true\n        end\n    end\nend",
["events"] = "SCHEDULED_WARNING, CLEU:SPELL_CAST_SUCCESS",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    status = \"string\",\n    expirationTime = true,\n}",
