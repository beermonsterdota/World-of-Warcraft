{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.castTime,\n                    expirationTime = GetTime() + aura_env.castTime,\n                    progressType = \"timed\",\n                    status = \"isCasting\"\n                }\n                aura_env.ScheduleWarning(aura_env.castTime)\n                return true\n            end\n        end\n    end\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if not aura_env.spellPhase[spellIdS] then\n            return false\n        end\n        \n        aura_env.phase = false\n        allstates[\"\"] = {\n            show = false,\n            changed = true,\n            status = \"onCD\"\n        }\n        return true\n    end\n    \n    if event == \"CHAT_MSG_MONSTER_YELL\" then\n        \n        if extra and aura_env.msgPhaseNature[extra] then\n            aura_env.count = 1\n            aura_env.phase = true\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n        \n        if extra and (aura_env.msgPhaseArcane[extra] or aura_env.msgPhaseShadow[extra] or aura_env.msgPhaseFire[extra]) then\n            aura_env.phase = false\n            allstates[\"\"] = {\n                show = false,\n                changed = true,\n                status = \"onCD\"\n            }\n            return true\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id and aura_env.phase == true then\n            aura_env.count = aura_env.count + 1\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdWindow - aura_env.castTime,\n                expirationTime = GetTime() + aura_env.cdWindow - aura_env.castTime,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        return true\n    end\nend",
["events"] = "ENCOUNTER_START, UNIT_SPELLCAST_SUCCEEDED, CLEU:SPELL_CAST_START, CHAT_MSG_MONSTER_YELL, SCHEDULED_WARNING",
