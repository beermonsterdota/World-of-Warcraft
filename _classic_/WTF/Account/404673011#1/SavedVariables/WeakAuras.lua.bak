["id"] = "СС: Иконка Ун'сок - Поглощение янтаря",
["customText"] = "function()\n    local multi = 6300000 -- 25 гер\n    local _, _, difficultyID = GetInstanceInfo()\n    -- 3 = 10 Нормал; 4 = 25 Нормал; 5 = 10 Героик; 6 = 25 Героик; 17 = ЛФР\n    if difficultyID == 3 then\n        multi =  2100000\n    elseif difficultyID == 4 then\n        multi = 6300000\n    elseif difficultyID == 5 then\n        multi = 2100000\n    elseif difficultyID == 17 then\n        multi = 100000\n    end\n    local colorCode = \"|cFFfff468+\"\n    \n    if multi * aura_env.state.stacks / 1000 < 1000 then\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000) .. \"k|r\"\n    else\n        return colorCode .. math.floor(multi * aura_env.state.stacks / 1000) / 1000 .. \"m|r\"\n    end\nend\n\n-- aura_env.count = aura_env.state.stacks\n\n--ТОЛЬКО ТЕКСТ\n--function()\n--local colorCode = \"|cFFfff468\"\n--return colorCode .. \"+100%|r\"\n--end\n\n--УЗНАТЬ ЗНАЧЕНИЕ ИЗ ДЕБАФА\n--function()\n--local colorCode = \"|cFFfff468\"\n--local damage = select(17, WA_GetUnitDebuff(\"player\", 105479)) or 1000\n--return colorCode .. math.floor(damage / 1000) .. \"k|r\"\n--end",
