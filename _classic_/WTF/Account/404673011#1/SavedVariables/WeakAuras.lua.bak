["events"] = "EMITY_SHA_LEFT_RIGHT, EMITY_SHA_LEFT_CENTER, EMITY_SHA_LEFT_OFF, EMITY_SHA_OFF",
["custom"] = "function(allstates, event)\n    if event == \"EMITY_SHA_LEFT_RIGHT\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n        }\n        return true\n    end\n    \n    if event == \"EMITY_SHA_LEFT_CENTER\" or event == \"EMITY_SHA_LEFT_OFF\" or event == \"EMITY_SHA_OFF\" then\n        if allstates[\"\"] then\n            allstates[\"\"].show = false\n            allstates[\"\"].changed = true\n            return true\n        end\n    end\nend",
