},
["spellIds"] = {
},
["custom"] = "function(allstates, event,_, subEvent,_,_,_,_,_, destGUID)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if aura_env.NPCs[npcID] then\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    autoHide = true,\n                    duration = aura_env.cdWindow,\n                    expirationTime = GetTime() + aura_env.cdWindow,\n                    progressType = \"timed\",\n                }\n                return true\n            end\n        end\n    end\nend\n\n\n",
["events"] = "CLEU:UNIT_DIED",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = true,\n}",
