["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent,_,_,_,_,_, destGUID,_,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if subEvent == \"UNIT_DIED\" then\n            local npcID = select(6, strsplit(\"-\", destGUID))\n            if aura_env.NPCs[npcID] then\n                aura_env.phaseThree = true\n                if allstates[\"\"] then\n                    allstates[\"\"] = {\n                        show = false,\n                        changed = true,\n                        status = \"onCD\"\n                    }\n                    return true\n                end\n            end\n        end\n        \n        if not aura_env.spell[spellId] and not aura_env.spellPhase[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_CAST_START\" and aura_env.spell[spellId] then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 8.5 then\n                aura_env.antispam = GetTime()\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.castTime,\n                    expirationTime = GetTime() + aura_env.castTime,\n                    progressType = \"timed\",\n                    status = \"isCasting\"\n                }\n                aura_env.ScheduleWarning(aura_env.castTime)\n                return true\n            end\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" and aura_env.spellPhase[spellId] then\n            aura_env.count = 1\n            aura_env.phaseThree = false\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                duration = aura_env.cdStart,\n                expirationTime = GetTime() + aura_env.cdStart,\n                progressType = \"timed\",\n                status = \"onCD\"\n            }\n            return true\n        end\n    end\n    \n    if event == 'SCHEDULED_WARNING' then\n        if extra == aura_env.id then\n            if aura_env.phaseThree == false then\n                aura_env.count = aura_env.count + 1\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.cdWindow - aura_env.castTime,\n                    expirationTime = GetTime() + aura_env.cdWindow - aura_env.castTime,\n                    progressType = \"timed\",\n                    status = \"onCD\"\n                }\n                return true\n            end\n        end\n    end\nend\n\n\n",
["events"] = "CLEU:SPELL_AURA_APPLIED, CLEU:SPELL_CAST_START, SCHEDULED_WARNING, CLEU:UNIT_DIED",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    status = \"string\",\n    expirationTime = true,\n}",
