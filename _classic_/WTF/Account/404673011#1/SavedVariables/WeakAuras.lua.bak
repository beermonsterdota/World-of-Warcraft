["events"] = "CLEU:SPELL_AURA_APPLIED",
["custom"] = "function(allstates, event,_, subEvent,_,_,_,_,_, destGUID, destName,_,_, spellId)\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" then\n            \n            allstates[destGUID] = {\n                show = true,\n                changed = true,\n                autoHide = true,\n                duration = 1.5,\n                expirationTime = GetTime() + 1.5,\n                progressType = \"timed\",\n                tar = destGUID,\n            }\n            return true\n        end\n    end\nend",
