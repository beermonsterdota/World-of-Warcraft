},
["finish"] = {
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\Xylophone.ogg",
["custom"] = "\n\n",
["do_custom"] = false,
["do_sound"] = false,
},
["init"] = {
["custom"] = "aura_env.spell = {\n    [123705] = 0,\n}\naura_env.count = 1\naura_env.cdStart = 10\naura_env.cdWindow = 10\naura_env.hastePercent = 0\n\nfunction aura_env.getFogInterval()\n    local baseInterval = aura_env.cdWindow\n    local haste = aura_env.hastePercent or 0\n    local interval = baseInterval / (1 + haste / 100)\n    \n    return interval\nend\n\nfunction aura_env.scheduleRepeat()\n    if aura_env.timer then\n        aura_env.timer:Cancel()\n        aura_env.timer = nil\n    end\n    local interval = aura_env.getFogInterval()\n    aura_env.timer = C_Timer.NewTimer(interval, function()\n            WeakAuras.ScanEvents(\"WA_LEI_SCARY_FOG_REPEAT\")\n    end)\nend",
["do_custom"] = true,
},
},
["texture"] = "EmityFlat",
["cooldown"] = false,
["zoom"] = 0.29999998211861,
["spark"] = false,
["compress"] = false,
["crop_x"] = 0.41,
["orientation"] = "HORIZONTAL",
["alpha"] = 1,
["information"] = {
["forceEvents"] = true,
["ignoreOptionsEventErrors"] = true,
},
["icon"] = false,
["config"] = {
},
["BFgloss"] = 0,
["displayText"] = "%i %s / 25 %i",
["foregroundTexture"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Auras\\Aura3",
["displayIcon"] = "",
["anchorFrameType"] = "SCREEN",
["iconInset"] = 0,
["outline"] = "OUTLINE",
["preferToUpdate"] = false,
["sparkOffsetX"] = 0,
["wagoID"] = "X2r68vxMW",
["parent"] = "Т14 Центр: Все боссы",
["anchorPoint"] = "CENTER",
["customText"] = "function()\n    return \"+\"..(3 * aura_env.state.stacks)..\"%\"\nend",
["shadowYOffset"] = -1,
["id"] = "ТВВ: Центр Лэй Ши - Жуткий туман",
["desaturateBackground"] = false,
["endAngle"] = 360,
["justify"] = "LEFT",
["sparkRotationMode"] = "AUTO",
["cooldownEdge"] = false,
["desaturateForeground"] = false,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "stateupdate",
["debuffType"] = "HELPFUL",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["spellIds"] = {
},
["custom"] = "function(allstates, event, extra, subEvent, spellIdS,_,_,_,_,_,_,_,_, spellId)\n    \n    if event == \"TRIGGER\" then\n        local triggerNum = extra\n        local triggerStates = subEvent\n        \n        if triggerNum == 2 then\n            for _, state in pairs(triggerStates) do\n                local haste = tonumber(state.tooltip1)\n                if haste then\n                    aura_env.hastePercent = haste\n                end\n            end\n        end\n        return true\n    end\n    \n    if event == \"WA_LEI_SCARY_FOG_REPEAT\" then\n        aura_env.scheduleRepeat()\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = aura_env.getFogInterval(),\n            expirationTime = GetTime() + aura_env.getFogInterval(),\n            progressType = \"timed\",\n        }\n        return true\n    end\n    \n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        \n        if not aura_env.spell[spellId] then\n            return false\n        end\n        \n        if subEvent == \"SPELL_AURA_APPLIED\" or subEvent == \"SPELL_AURA_APPLIED_DOSE\" then\n            if not aura_env.antispam or GetTime() - aura_env.antispam > 2.5 then\n                aura_env.antispam = GetTime()\n                aura_env.scheduleRepeat()\n                allstates[\"\"] = {\n                    show = true,\n                    changed = true,\n                    duration = aura_env.getFogInterval(),\n                    expirationTime = GetTime() + aura_env.getFogInterval(),\n                    progressType = \"timed\",\n                }\n                return true\n            end\n        end\n    end\n    \n    if event == \"ENCOUNTER_START\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            duration = aura_env.cdStart,\n            expirationTime = GetTime() + aura_env.cdStart,\n            progressType = \"timed\",\n        }\n        return true\n    end\nend",
["events"] = "ENCOUNTER_START, CLEU:SPELL_AURA_APPLIED, CLEU:SPELL_AURA_APPLIED_DOSE, TRIGGER:2, WA_LEI_SCARY_FOG_REPEAT",
["check"] = "event",
["unit"] = "player",
["customVariables"] = "{\n    expirationTime = true,\n}",
