["do_custom"] = false,
},
["init"] = {
["do_custom_load"] = false,
["custom"] = "aura_env.k = aura_env.config.option.asani\naura_env.interruptCounts = {}\naura_env.npcId = \"60585\"\naura_env.rotation = 4\naura_env.castTime = 2\naura_env.marks = {}\n\naura_env.trackedSpells = {\n    [117187] = true, -- Молния\n}\n\nfunction aura_env.shouldShowState(guid)\n    if not guid then\n        return false\n    end\n    local npcId = select(6, strsplit(\"-\", guid or \"\"))\n    if npcId ~= aura_env.npcId then\n        return false\n    end\n    \n    if aura_env.k.showOnlyMine then\n        local count = aura_env.interruptCounts[guid] or 1\n        local myTurn = aura_env.k.interruptAssign or 1\n        if count ~= (myTurn - 1) then\n            return false\n        end\n    end\n    \n    return true\nend\n\nfunction aura_env.updateVisibleNameplateUnits(allstates, changedGUID, status)\n    for _, plateData in ipairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        local guid = UnitGUID(unit)\n        if guid and guid == changedGUID then\n            aura_env.updateState(allstates, guid, status, unit)\n        end\n    end\nend\n\nfunction aura_env.updateState(allstates, guid, status, unit)\n    if not guid then return end\n    \n    local count = aura_env.interruptCounts[guid] or 1\n    local duration, expirationTime = 0, GetTime()\n    if status == \"Casting\" then\n        duration = aura_env.castTime\n        expirationTime = duration + GetTime()\n    end\n    \n    local raidMark = aura_env.marks and aura_env.marks[guid]\n    local raidMarkStr = raidMark and raidMark > 0 and (\"{rt\" .. raidMark .. \"}\") or \"\"\n    \n    if aura_env.shouldShowState(guid) then\n        allstates[guid] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            rotation = count,\n            status = status or \"Idle\",\n            duration = duration,\n            expirationTime = expirationTime,\n            raidMark = raidMarkStr,\n            unit = unit,\n        }\n    else\n        if allstates[guid] then\n            allstates[guid].show = false\n            allstates[guid].changed = true\n        end\n    end\nend\n\nfunction aura_env.iterateNameplatesAndUpdate()\n    for _, plateData in ipairs(C_NamePlate.GetNamePlates()) do\n        local unit = plateData.UnitFrame.displayedUnit\n        local guid = UnitGUID(unit)\n        local raidMark = GetRaidTargetIndex(unit)\n        if guid then\n            WeakAuras.ScanEvents(\"WA_ASANI_MARKS_UPDATED\", guid, unit, raidMark)\n        end\n    end\nend\n\nfunction aura_env.onRaidTargetUpdate()\n    C_Timer.After(0.1, aura_env.iterateNameplatesAndUpdate)\nend",
["do_custom"] = true,
},
},
["fontFlags"] = "OUTLINE",
