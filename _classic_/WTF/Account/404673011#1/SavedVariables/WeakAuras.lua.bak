["custom"] = "function(event, _, _, spellId)\n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        \n        if aura_env.spellStart[spellId] then\n            return true\n        end\n        \n    end\nend\n\n\n\n\n",
